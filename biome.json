{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "maxSize": 2097152,
    "includes": [
      "**",
      "!!**/node_modules",
      "!!**/dist",
      "!!**/coverage",
      "!!**/playwright-report",
      "!!**/test-results",
      "!!**/.venv",
      "!!frontend/src/api/schema.d.ts",
      "!pnpm-lock.yaml",
      "!**/.claude/settings.local.json",
      "!!backend/schema.yml",
      "!docs/design/**/*.html"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 120
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "jsxQuoteStyle": "double",
      "trailingCommas": "none",
      "semicolons": "always",
      "arrowParentheses": "always"
    }
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  },
  "markdown": {
    "formatter": {
      "enabled": false
    }
  },
  "assist": {
    "actions": {
      "source": {
        "organizeImports": {
          "level": "on",
          "options": {
            "groups": [
              [":NODE:", ":BUN:", ":PACKAGE:", ":PACKAGE_WITH_PROTOCOL:", ":URL:"],
              ":BLANK_LINE:",
              ":ALIAS:",
              ":BLANK_LINE:",
              ":PATH:",
              ":BLANK_LINE:",
              ":STYLE:"
            ]
          }
        }
      }
    }
  },
  "plugins": [
    "./tools/biome/no-arbitrary-radius.grit",
    "./tools/biome/no-let.grit",
    "./tools/biome/button-pressed-state.grit",
    "./tools/biome/no-function-declaration.grit",
    "./tools/biome/token-only-styling.grit",
    "./tools/biome/token-only-styling-css.grit",
    "./tools/biome/area-boundaries.grit"
  ],
  "linter": {
    "enabled": true,
    "domains": {
      "react": "recommended",
      "test": "recommended"
    },
    "rules": {
      "preset": "recommended",
      "correctness": {
        "noUnusedImports": "error",
        "noUnusedVariables": {
          "level": "error",
          "options": {
            "ignoreRestSiblings": true
          }
        },
        "useExhaustiveDependencies": "warn",
        "useHookAtTopLevel": "error"
      },
      "style": {
        "useImportType": "error",
        "useExportType": "error",
        "useConst": "error",
        "noParameterAssign": "error",
        "useSelfClosingElements": "error",
        "noUselessElse": "error"
      },
      "suspicious": {
        "noConsole": "warn",
        "noExplicitAny": "error"
      },
      "nursery": {
        "noFloatingPromises": "warn",
        "noMisusedPromises": "warn"
      }
    }
  },
  "overrides": [
    {
      "includes": ["**/*.test.ts", "**/*.test.tsx", "**/*.spec.ts", "**/*.spec.tsx", "**/e2e/**", "**/scripts/**"],
      "linter": {
        "rules": {
          "suspicious": {
            "noConsole": "off"
          },
          "nursery": {
            "noFloatingPromises": "off"
          }
        }
      }
    },
    {
      "includes": ["frontend/**"],
      "linter": {
        "rules": {
          "complexity": {
            "noForEach": "error"
          },
          "style": {
            "useFilenamingConvention": {
              "level": "error",
              "options": {
                "filenameCases": ["kebab-case"]
              }
            },
            "noDefaultExport": "error",
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "paths": {
                  "react": {
                    "importNames": ["default", "*"],
                    "message": "Import what you need from 'react' by name, not React as a whole (AGENTS.md › Frontend)."
                  },
                  "cn": {
                    "message": "Import cn from '@/dino/cn', not the cn package: shadcn's registry adds it (specs/lessons/shadcn-registry-imports-cn-package.md)."
                  }
                }
              }
            }
          }
        }
      }
    },
    {
      "includes": [
        "frontend/**/*.stories.tsx",
        "frontend/*.config.ts",
        "frontend/stryker.config.mjs",
        "frontend/.storybook/main.ts",
        "frontend/.storybook/preview.tsx"
      ],
      "linter": {
        "rules": {
          "style": {
            "noDefaultExport": "off"
          }
        }
      }
    }
  ]
}
